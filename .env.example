# Copier ce fichier en .env et remplir avec vos vraies valeurs.
# Le fichier .env n'est jamais committé (cf .gitignore).

# --- Google Cloud / BigQuery ---
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_LOCATION=US

# --- ACLED API (validation croisée) ---
# Inscription gratuite : https://developer.acleddata.com/
ACLED_API_KEY=
ACLED_EMAIL=

# --- GDELT Cloud (free tier, validation et enrichissement) ---
# Inscription : https://gdeltcloud.com/
GDELTCLOUD_API_KEY=

# --- HuggingFace (modèles locaux gratuits, pas de clé requise pour modèles publics) ---
# HF_TOKEN=  # uniquement si modèle privé

# --- Snapshot ---
# Année calendaire 2025 (consigne hackathon).
# Intervalle semi-ouvert : SNAPSHOT_DATE_TO est exclusive (2026-01-01 = jusqu'au 31/12/2025 inclus).
SNAPSHOT_DATE_FROM=2025-01-01
SNAPSHOT_DATE_TO=2026-01-01
