# Copier ce fichier en .env et remplir avec vos vraies valeurs.
# Le fichier .env n'est jamais committé (cf .gitignore).

# --- Google Cloud / BigQuery ---
# Deux modes d'authentification supportés :
#
# Mode A (rapide, recommandé pour le hackathon) — Application Default Credentials :
#   1. Installer gcloud CLI : https://cloud.google.com/sdk/docs/install
#   2. Lancer : gcloud auth application-default login
#   3. Laisser GOOGLE_APPLICATION_CREDENTIALS vide ci-dessous.
#
# Mode B (production) — service account JSON :
#   1. Console GCP -> IAM -> Service Accounts -> Create
#   2. Rôles : "BigQuery User" + "BigQuery Data Viewer"
#   3. Télécharger la clé JSON, la placer à la racine sous gcp-credentials.json
#   4. Renseigner GOOGLE_APPLICATION_CREDENTIALS ci-dessous.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_LOCATION=US

# --- ACLED API (validation croisée) ---
# Inscription gratuite : https://developer.acleddata.com/
ACLED_API_KEY=
ACLED_EMAIL=

# --- GDELT Cloud (free tier, validation et enrichissement) ---
# Inscription : https://gdeltcloud.com/
GDELTCLOUD_API_KEY=

# --- HuggingFace (modèles locaux gratuits, pas de clé requise pour modèles publics) ---
# HF_TOKEN=  # uniquement si modèle privé

# --- Snapshot ---
# Année calendaire 2025 (consigne hackathon).
# Intervalle semi-ouvert : SNAPSHOT_DATE_TO est exclusive (2026-01-01 = jusqu'au 31/12/2025 inclus).
SNAPSHOT_DATE_FROM=2025-01-01
SNAPSHOT_DATE_TO=2026-01-01
